          node_pointer n = next_node(prev);
          node_pointer n2 = next_node(n);
          if (n2) {
            n2->set_first_in_group();
          }
          prev->next_ = n2;
          --this->size_;
          this->fix_bucket(bucket_index, prev, n2);
          n->next_ = link_pointer();

          return n;
        }



